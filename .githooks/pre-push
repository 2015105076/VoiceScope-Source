#!/bin/sh
# Validate each outgoing ref including all of its ancestors.
set -eu
while read -r local_ref local_oid remote_ref remote_oid
do
    case "$local_oid" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    python3 scripts/check_publication.py "$local_oid" || exit 1
done
